--[[
    JJS Auto Block v4
    Tự quét animation của người gần nhất, CHỈ block đòn đánh (M1) và lướt (Dash):
      - Xoay NGƯỜI (không đổi góc nhìn camera) về phía họ
      - Giữ phím block đến khi animation đó kết thúc

    Phân loại animation:
      1. Chính xác nhất: bật "Chế độ học", để người khác đánh/lướt gần bạn,
         rồi bấm vào từng dòng log để đổi loại: ? -> M1 -> Dash -> ?
      2. Đoán theo tên animation (M1_KEYWORDS / DASH_KEYWORDS bên dưới) - chỉ là ước đoán.
    Animation chưa phân loại sẽ bị bỏ qua khi bật "Chỉ block đánh/lướt".
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

-- ===== Cấu hình =====
local BLOCK_KEY = Enum.KeyCode.F    -- phím block trong game
local TOGGLE_KEY = Enum.KeyCode.G   -- bật/tắt Auto Block nhanh
local USE_KEYPRESS = false          -- true: dùng keypress()/keyrelease() của executor thay cho VirtualInputManager
local MAX_BLOCK_TIME = 4            -- giây, giới hạn an toàn cho một lần giữ block
local BODY_TURN_SPEED = 30          -- càng cao càng xoay người nhanh
local PRESET_ANIMS = {
    -- ["rbxassetid://1234567890"] = "M1",
    -- ["rbxassetid://1234567891"] = "Dash",
}
-- Từ khoá để đoán loại theo tên animation (chữ thường, chỉ là ước đoán)
local M1_KEYWORDS = { "m1", "punch", "attack", "combo", "swing", "slash", "strike", "hit" }
local DASH_KEYWORDS = { "dash", "slide", "sidestep" }

-- ===== Dọn bản chạy trước =====
local env = (getgenv and getgenv()) or _G
if env.JJS_AutoBlockCleanup then
    pcall(env.JJS_AutoBlockCleanup)
end

local parentGui = (gethui and gethui()) or CoreGui
local connections = {}
local function track(c) table.insert(connections, c) return c end

env.JJS_AutoBlockCats = env.JJS_AutoBlockCats or {}
local catSet = env.JJS_AutoBlockCats   -- [AnimationId] = "M1" | "Dash"
for id, cat in pairs(PRESET_ANIMS) do
    catSet[id] = cat
end

local settings = {
    Enabled = false,
    Learn = false,
    FilterTypes = true,
    BlockM1 = true,
    BlockDash = true,
    TurnBody = true,
    RestoreFacing = false,
    SkipBehind = false,
    OnlyNearest = true,
    Facing = false,
    Range = 20,
    Delay = 0,
    MinHold = 0.15,
}

-- ===== Theme + helper =====
local T = {
    Bg = Color3.fromRGB(13, 13, 19),
    Panel = Color3.fromRGB(19, 19, 28),
    Element = Color3.fromRGB(26, 26, 38),
    Hover = Color3.fromRGB(36, 36, 52),
    Off = Color3.fromRGB(52, 52, 72),
    Stroke = Color3.fromRGB(44, 44, 64),
    Accent = Color3.fromRGB(0, 229, 255),
    Good = Color3.fromRGB(70, 220, 120),
    Text = Color3.fromRGB(238, 238, 245),
    Sub = Color3.fromRGB(150, 150, 172),
}

local function create(class, props, children)
    local inst = Instance.new(class)
    if inst:IsA("GuiObject") then inst.BorderSizePixel = 0 end
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else inst[k] = v end
    end
    for _, ch in ipairs(children or {}) do ch.Parent = inst end
    inst.Parent = parent
    return inst
end

local function tween(inst, t, props)
    TweenService:Create(inst, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function corner(r) return create("UICorner", { CornerRadius = UDim.new(0, r) }) end

local function count(t)
    local n = 0
    for _ in pairs(t) do n += 1 end
    return n
end

-- ===== Nhấn phím block =====
local keyDown = false

local function keyVK()
    local n = BLOCK_KEY.Name
    if #n == 1 then return string.byte(n) end
    return nil
end

local function pressBlock(down)
    if down == keyDown then return end
    keyDown = down
    if USE_KEYPRESS and keypress and keyrelease and keyVK() then
        pcall(down and keypress or keyrelease, keyVK())
    else
        pcall(function()
            VirtualInputManager:SendKeyEvent(down, BLOCK_KEY, false, game)
        end)
    end
end

-- ===== Phiên block (session) =====
-- session = { tracks = {[AnimationTrack] = true}, startTime, savedLook, autoRotate, turned, target(hrp) }
local session = nil
local BIND_NAME = "JJS_AutoBlockTurn"

local function getMyParts()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return root, hum
end

local function endSession()
    if not session then return end
    pressBlock(false)
    local root, hum = getMyParts()
    if hum and session.autoRotate ~= nil then
        hum.AutoRotate = session.autoRotate
    end
    if root and session.turned and settings.RestoreFacing and session.savedLook then
        local pos = root.Position
        root.CFrame = CFrame.lookAt(pos, pos + session.savedLook)
    end
    session = nil
end

local function startOrExtend(animTrack, hrp)
    if not settings.Enabled then return end
    if not session then
        local root, hum = getMyParts()
        local look = root and root.CFrame.LookVector or Vector3.new(0, 0, -1)
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
        session = {
            tracks = {},
            startTime = os.clock(),
            savedLook = flat.Unit,
            autoRotate = hum and hum.AutoRotate,
            turned = false,
            target = nil,
        }
        if settings.TurnBody and hum then
            hum.AutoRotate = false
        end
        pressBlock(true)
    end
    session.tracks[animTrack] = true
    session.target = hrp
end

RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function(dt)
    if not session then return end

    if not settings.Enabled then
        endSession()
        return
    end

    -- Kiểm tra các animation còn chạy không
    local anyPlaying = false
    for animTrack in pairs(session.tracks) do
        local alive = animTrack.IsPlaying
            and not (animTrack.Length > 0 and animTrack.TimePosition >= animTrack.Length)
        if alive then
            anyPlaying = true
        else
            session.tracks[animTrack] = nil
        end
    end

    local elapsed = os.clock() - session.startTime
    if (not anyPlaying and elapsed >= settings.MinHold) or elapsed > MAX_BLOCK_TIME then
        endSession()
        return
    end

    -- Xoay người (không động tới camera) về phía người tấn công
    if settings.TurnBody then
        local hrp = session.target
        local root = getMyParts()
        if hrp and hrp.Parent and root then
            local dir = hrp.Position - root.Position
            local flatDir = Vector3.new(dir.X, 0, dir.Z)
            if flatDir.Magnitude > 0.1 then
                local behind = session.savedLook:Dot(flatDir.Unit) <= 0
                if not (settings.SkipBehind and behind) then
                    local pos = root.Position
                    local desired = CFrame.lookAt(pos, pos + flatDir)
                    local alpha = 1 - math.exp(-BODY_TURN_SPEED * dt)
                    root.CFrame = root.CFrame:Lerp(desired, alpha)
                    session.turned = true
                end
            end
        end
    end
end)

-- ===== GUI =====
for _, root in ipairs({ CoreGui, parentGui }) do
    local old = root:FindFirstChild("JJS_AutoBlock")
    if old then old:Destroy() end
end

local Gui = create("ScreenGui", { Name = "JJS_AutoBlock", ResetOnSpawn = false, Parent = parentGui })

local Panel = create("Frame", {
    Parent = Gui,
    Position = UDim2.new(0, 40, 0, 90),
    Size = UDim2.new(0, 310, 0, 460),
    BackgroundColor3 = T.Bg,
}, {
    corner(10),
    create("UIStroke", { Color = T.Accent, Thickness = 1.5, Transparency = 0.3 }),
})

local TopBar = create("Frame", { Parent = Panel, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = T.Panel }, { corner(10) })
create("Frame", { Parent = TopBar, Position = UDim2.new(0, 0, 1, -10), Size = UDim2.new(1, 0, 0, 10), BackgroundColor3 = T.Panel })
create("TextLabel", {
    Parent = TopBar, BackgroundTransparency = 1,
    Position = UDim2.new(0, 14, 0, 0), Size = UDim2.new(1, -60, 1, 0),
    Font = Enum.Font.GothamBold, Text = "🛡️ JJS Auto Block v4", TextSize = 14,
    TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Left,
})
local CloseBtn = create("TextButton", {
    Parent = TopBar, AnchorPoint = Vector2.new(1, 0.5),
    Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.new(0, 26, 0, 26),
    BackgroundColor3 = T.Element, Font = Enum.Font.GothamBold, Text = "X",
    TextSize = 12, TextColor3 = T.Text, AutoButtonColor = false,
}, { corner(6) })

do -- kéo thả
    local dragging, startInput, startPos = false, nil, nil
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startInput = input.Position
            startPos = Panel.Position
        end
    end)
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - startInput
            Panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

local List = create("ScrollingFrame", {
    Parent = Panel,
    BackgroundTransparency = 1,
    Position = UDim2.new(0, 10, 0, 48),
    Size = UDim2.new(1, -20, 1, -58),
    CanvasSize = UDim2.new(0, 0, 0, 0),
    AutomaticCanvasSize = Enum.AutomaticSize.Y,
    ScrollBarThickness = 3,
    ScrollBarImageColor3 = T.Accent,
}, {
    create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
    create("UIPadding", { PaddingRight = UDim.new(0, 6) }),
})

local StatusLabel = create("TextLabel", {
    Parent = List, LayoutOrder = 0,
    Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1,
    Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.Sub,
    TextXAlignment = Enum.TextXAlignment.Left, Text = "",
})
local DebugLabel = create("TextLabel", {
    Parent = List, LayoutOrder = 1,
    Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1,
    Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = T.Sub, TextWrapped = true,
    TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
    Text = "Chưa thấy animation nào.",
})

local function setDebug(text)
    DebugLabel.Text = text
end

local statusToken = 0
local function refreshStatus()
    StatusLabel.Text = ("Auto Block: %s  ·  Đã gán loại: %d  ·  Phím: %s"):format(
        settings.Enabled and "BẬT" or "TẮT", count(catSet), BLOCK_KEY.Name)
    StatusLabel.TextColor3 = settings.Enabled and T.Good or T.Sub
end
local function flashStatus(text)
    statusToken += 1
    local my = statusToken
    StatusLabel.Text = text
    StatusLabel.TextColor3 = T.Accent
    task.delay(2, function()
        if my == statusToken then refreshStatus() end
    end)
end

local function sectionLabel(text, order)
    create("TextLabel", {
        Parent = List, LayoutOrder = order,
        Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold, Text = string.upper(text), TextSize = 11,
        TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Left,
    })
end

local function toggleRow(text, default, order, callback)
    local f = create("Frame", { Parent = List, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.Element }, { corner(8) })
    create("TextLabel", {
        Parent = f, BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -70, 1, 0),
        Font = Enum.Font.Gotham, Text = text, TextSize = 12,
        TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
    })
    local pill = create("Frame", {
        Parent = f, AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 40, 0, 20),
        BackgroundColor3 = T.Off,
    }, { corner(10) })
    local knob = create("Frame", {
        Parent = pill, AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.new(0, 14, 0, 14),
        BackgroundColor3 = T.Text,
    }, { corner(7) })
    local hit = create("TextButton", { Parent = f, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" })

    local value = default
    local function render()
        tween(pill, 0.15, { BackgroundColor3 = value and T.Accent or T.Off })
        tween(knob, 0.15, { Position = value and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
    end
    local function set(v, silent)
        value = v
        render()
        if not silent then callback(v) end
    end
    hit.MouseButton1Click:Connect(function() set(not value) end)
    render()
    return set
end

local function sliderRow(text, min, max, default, inc, suffix, order, callback)
    local f = create("Frame", { Parent = List, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 50), BackgroundColor3 = T.Element }, { corner(8) })
    create("TextLabel", {
        Parent = f, BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 5), Size = UDim2.new(1, -90, 0, 18),
        Font = Enum.Font.Gotham, Text = text, TextSize = 12,
        TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
    })
    local valLabel = create("TextLabel", {
        Parent = f, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 5), Size = UDim2.new(0, 70, 0, 18),
        Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.Accent,
        TextXAlignment = Enum.TextXAlignment.Right, Text = "",
    })
    local bar = create("Frame", {
        Parent = f, Position = UDim2.new(0, 12, 0, 32), Size = UDim2.new(1, -24, 0, 6),
        BackgroundColor3 = T.Off,
    }, { corner(3) })
    local fill = create("Frame", { Parent = bar, Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.Accent }, { corner(3) })
    local knob = create("Frame", {
        Parent = bar, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 14, 0, 14),
        BackgroundColor3 = T.Text,
    }, { corner(7) })
    local hit = create("TextButton", {
        Parent = f, Position = UDim2.new(0, 6, 0, 22), Size = UDim2.new(1, -12, 0, 26),
        BackgroundTransparency = 1, Text = "",
    })

    local value = default
    local function render()
        local a = (value - min) / (max - min)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        valLabel.Text = tostring(value) .. suffix
    end
    local function set(v)
        v = math.clamp(math.floor(v / inc + 0.5) * inc, min, max)
        value = tonumber(string.format("%.3f", v))
        render()
        callback(value)
    end
    local sliding = false
    local function fromX(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        set(min + a * (max - min))
    end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            fromX(input.Position.X)
        end
    end)
    track(UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            fromX(input.Position.X)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end))
    render()
end

local function buttonRow(text, order, callback)
    local b = create("TextButton", {
        Parent = List, LayoutOrder = order,
        Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element,
        Font = Enum.Font.GothamSemibold, Text = text, TextSize = 12,
        TextColor3 = T.Text, AutoButtonColor = false,
    }, { corner(8) })
    b.MouseEnter:Connect(function() tween(b, 0.12, { BackgroundColor3 = T.Hover }) end)
    b.MouseLeave:Connect(function() tween(b, 0.12, { BackgroundColor3 = T.Element }) end)
    b.MouseButton1Click:Connect(callback)
end

-- ===== Log animation =====
local logged = {}
local logCount = 0
local MAX_LOG = 60

local function shortId(id)
    return id:match("%d+") or id
end

local function guessCategory(name)
    local n = string.lower(name or "")
    for _, k in ipairs(DASH_KEYWORDS) do
        if n:find(k, 1, true) then return "Dash" end
    end
    for _, k in ipairs(M1_KEYWORDS) do
        if n:find(k, 1, true) then return "M1" end
    end
    return nil
end

local function addLogRow(id, animName, playerName)
    if logged[id] or logCount >= MAX_LOG then return end
    logCount += 1
    local displayName = (animName ~= "" and animName) or "(không tên)"
    local row = create("TextButton", {
        Parent = List, LayoutOrder = 100 + logCount,
        Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = T.Element,
        Text = "", AutoButtonColor = false,
    }, { corner(8) })
    local stroke = create("UIStroke", { Parent = row, Color = T.Stroke, Thickness = 1 })
    local label = create("TextLabel", {
        Parent = row, BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -20, 1, 0),
        Font = Enum.Font.Gotham, TextSize = 11, TextWrapped = true,
        TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left,
        Text = "",
    })
    local function render()
        local cat = catSet[id]
        local tag, color
        if cat == "M1" then
            tag, color = "[M1]", T.Good
        elseif cat == "Dash" then
            tag, color = "[Dash]", T.Accent
        else
            local guess = guessCategory(animName)
            tag = guess and ("[? đoán " .. guess .. "]") or "[?]"
        end
        stroke.Color = color or T.Stroke
        label.TextColor3 = color or T.Text
        label.Text = ("%s %s  ·  %s\n%s"):format(tag, displayName, playerName, shortId(id))
    end
    row.MouseButton1Click:Connect(function()
        local cur = catSet[id]
        if cur == nil then
            catSet[id] = "M1"
        elseif cur == "M1" then
            catSet[id] = "Dash"
        else
            catSet[id] = nil
        end
        render()
        refreshStatus()
    end)
    logged[id] = row
    render()
end

for id in pairs(catSet) do
    addLogRow(id, "(đã lưu)", "—")
end

-- ===== Điều khiển =====
sectionLabel("Điều khiển", 2)
local setEnabled = toggleRow("Auto Block (phím G)", false, 3, function(v)
    settings.Enabled = v
    if not v then endSession() end
    refreshStatus()
end)
toggleRow("Chỉ block đánh / lướt (lọc theo loại)", true, 4, function(v) settings.FilterTypes = v end)
toggleRow("   Block đòn đánh (M1)", true, 5, function(v) settings.BlockM1 = v end)
toggleRow("   Block lướt (Dash)", true, 6, function(v) settings.BlockDash = v end)
toggleRow("Xoay người về phía đối thủ", true, 7, function(v) settings.TurnBody = v end)
toggleRow("Trả hướng người về như cũ sau block", false, 8, function(v) settings.RestoreFacing = v end)
toggleRow("Không xoay khi đối thủ ở sau lưng", false, 9, function(v) settings.SkipBehind = v end)
toggleRow("Chỉ người gần nhất", true, 10, function(v) settings.OnlyNearest = v end)
toggleRow("Chỉ khi đối thủ hướng về mình", false, 11, function(v) settings.Facing = v end)
toggleRow("Chế độ học (ghi log animation)", false, 12, function(v)
    settings.Learn = v
    flashStatus(v and "Học: bấm vào dòng log để đổi loại ? > M1 > Dash" or "Đã tắt chế độ học")
end)

sectionLabel("Tuỳ chỉnh", 13)
sliderRow("Tầm phát hiện", 5, 50, settings.Range, 1, " studs", 14, function(v) settings.Range = v end)
sliderRow("Độ trễ phản ứng", 0, 0.5, settings.Delay, 0.01, " s", 15, function(v) settings.Delay = v end)
sliderRow("Giữ block tối thiểu", 0.05, 1, settings.MinHold, 0.05, " s", 16, function(v) settings.MinHold = v end)

sectionLabel("Danh sách animation", 17)
buttonRow("📋 Copy danh sách đã gán loại", 18, function()
    local lines = {}
    for id, cat in pairs(catSet) do
        table.insert(lines, ('    ["%s"] = "%s",'):format(id, cat))
    end
    table.sort(lines)
    local s = "local PRESET_ANIMS = {\n" .. table.concat(lines, "\n") .. "\n}"
    print(s)
    local copy = setclipboard or toclipboard
    if copy then
        copy(s)
        flashStatus("Đã copy " .. #lines .. " animation vào clipboard")
    else
        flashStatus("Executor không có clipboard, đã in ra console (F9)")
    end
end)
buttonRow("🗑️ Xoá log (giữ animation đã gán loại)", 19, function()
    for id, row in pairs(logged) do
        if not catSet[id] then
            row:Destroy()
            logged[id] = nil
        end
    end
    logCount = count(logged)
    flashStatus("Đã xoá log")
end)

refreshStatus()

-- ===== Quét animation của người gần nhất =====
local lastPos = setmetatable({}, { __mode = "k" })

local IGNORED_PRIORITY = {
    [Enum.AnimationPriority.Core] = true,
    [Enum.AnimationPriority.Idle] = true,
    [Enum.AnimationPriority.Movement] = true,
}

local function getAnimator(char)
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    return animator or char:FindFirstChildWhichIsA("Animator", true)
end

local function onFreshAnimation(player, hrp, myRoot, animTrack)
    local anim = animTrack.Animation
    local id = anim and anim.AnimationId
    if not id or id == "" then return end
    local name = (anim.Name ~= "" and anim.Name) or shortId(id)

    if IGNORED_PRIORITY[animTrack.Priority] then
        setDebug(("Bỏ qua (ưu tiên %s): %s"):format(animTrack.Priority.Name, name))
        return
    end

    if settings.Learn then
        addLogRow(id, anim.Name, player.Name)
    end
    if not settings.Enabled then return end

    local cat = catSet[id] or guessCategory(anim.Name)
    if settings.FilterTypes then
        if not cat then
            setDebug(("Chưa phân loại: %s — dùng chế độ học để gán M1/Dash"):format(name))
            return
        end
        if (cat == "M1" and not settings.BlockM1) or (cat == "Dash" and not settings.BlockDash) then
            setDebug(("Bỏ qua [%s] %s (đang tắt loại này)"):format(cat, name))
            return
        end
    end

    if settings.Facing then
        local toMe = myRoot.Position - hrp.Position
        if toMe.Magnitude > 0 and hrp.CFrame.LookVector:Dot(toMe.Unit) < 0.25 then
            setDebug(("%s · %s: đối thủ không hướng về bạn"):format(player.Name, name))
            return
        end
    end

    setDebug(("🛡️ Block [%s] ← %s · %s"):format(cat or "?", player.Name, name))
    local function go()
        if animTrack.IsPlaying then
            startOrExtend(animTrack, hrp)
        end
    end
    if settings.Delay > 0 then
        task.delay(settings.Delay, go)
    else
        go()
    end
end

track(RunService.Heartbeat:Connect(function()
    if not (settings.Enabled or settings.Learn) then return end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local candidates = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - myRoot.Position).Magnitude
                if dist <= settings.Range then
                    table.insert(candidates, { player = p, hrp = hrp, dist = dist })
                end
            end
        end
    end
    if #candidates == 0 then return end

    table.sort(candidates, function(a, b) return a.dist < b.dist end)
    if settings.OnlyNearest and not settings.Learn then
        candidates = { candidates[1] }
    end

    for _, c in ipairs(candidates) do
        local animator = getAnimator(c.player.Character)
        if animator then
            for _, animTrack in ipairs(animator:GetPlayingAnimationTracks()) do
                if not animTrack.Looped then
                    local pos = animTrack.TimePosition
                    local last = lastPos[animTrack]
                    local fresh = (last == nil and pos < 0.25) or (last ~= nil and pos < last - 0.05)
                    lastPos[animTrack] = pos
                    if fresh then
                        onFreshAnimation(c.player, c.hrp, myRoot, animTrack)
                    end
                end
            end
        end
    end
end))

-- ===== Phím tắt + dọn dẹp =====
track(UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == TOGGLE_KEY then
        setEnabled(not settings.Enabled)
    end
end))

local function cleanup()
    settings.Enabled = false
    settings.Learn = false
    endSession()
    pressBlock(false)
    pcall(function() RunService:UnbindFromRenderStep(BIND_NAME) end)
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(connections)
    Gui:Destroy()
    env.JJS_AutoBlockCleanup = nil
end
env.JJS_AutoBlockCleanup = cleanup
CloseBtn.MouseButton1Click:Connect(cleanup)
